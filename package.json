{
  "name": "ime-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test:business": "node --experimental-strip-types --test tests/business/*.test.mjs",
    "test:pdf": "node --import tsx scripts/generate-pdf-fixtures.tsx && python3 scripts/validate-pdf-output.py",
    "test:migrations": "node scripts/validate-migrations.mjs",
    "check:production-env": "node scripts/check-production-env.mjs",
    "backup:database": "bash scripts/backup-database.sh",
    "backup:storage": "node scripts/backup-storage.mjs",
    "validate:final": "npm run type-check && npm run lint && npm run test:business && npm run test:migrations && npm run test:pdf && npm run build && npm audit --omit=dev --audit-level=high",
    "audit:phase7": "node scripts/phase7-static-audit.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.6.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "^2.44.4",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "exceljs": "4.4.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.52.1",
    "recharts": "^3.10.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.8",
    "@types/node": "^20.14.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.19",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.24",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.20.6",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "dompurify": "3.4.12",
    "minimatch": "10.2.6",
    "postcss": "$postcss",
    "sharp": "0.35.3",
    "uuid": "11.1.1"
  }
}
